# Phase 1: replace these placeholders in .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Supabase GitHub OAuth provider. Server-only; never use NEXT_PUBLIC_.
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=replace_me
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=replace_me

# Phase 6 only. Keep this token on the server.
# GITHUB_TOKEN=replace_me
