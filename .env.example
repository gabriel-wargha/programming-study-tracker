# Copy to .env.local. Never commit real values.

# Phases 1-7: local development with an embedded PGlite database.
# The local owner works only under `next dev`, never in a production build or on Vercel.
LOCAL_OWNER_MODE=1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 6: server-only, read-only token for public repositories.
# GITHUB_TOKEN=replace_me

# Phase 8: Neon. Server-only; never prefix these with NEXT_PUBLIC_.
# DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require
# NEON_AUTH_BASE_URL=https://endpoint.neonauth.region.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=replace_with_openssl_rand_base64_32
# ALLOWED_USER_IDS=replace_with_your_neon_auth_user_id
